# SIGM Cloud — variables de entorno para producción
# Copie este archivo al gestor de secretos del entorno. No lo confirme con valores reales.

# Base de datos (obligatorio). Producción rechaza credenciales/host de desarrollo.
ConnectionStrings__Default=Host=db.interno;Port=5432;Database=sigm;Username=sigm_app;Password=CAMBIAR
ConnectionStrings__Platform=Host=db.interno;Port=5432;Database=sigm;Username=sigm_platform;Password=CAMBIAR

# Firma de JWT (obligatorio, mínimo 32 caracteres aleatorios).
Jwt__Key=CAMBIAR_POR_CLAVE_ALEATORIA_DE_64_CARACTERES
Jwt__Issuer=sigm-cloud
Jwt__Audience=sigm-cloud-clients

# Orígenes permitidos por CORS (lista separada; en JSON use CORS__AllowedOrigins__0, __1, ...)
CORS__AllowedOrigins__0=https://app.su-dominio.co

# Correo transaccional (recuperación de contraseña y avisos de seguridad)
Reminders__Smtp__Host=smtp.proveedor.com
Reminders__Smtp__Port=587
Reminders__Smtp__UseStartTls=true
Reminders__Smtp__FromAddress=no-reply@su-dominio.co
Reminders__Smtp__FromName=SIGM Cloud
Reminders__Smtp__User=usuario-smtp
Reminders__Smtp__Password=CAMBIAR
Reminders__DeliveryEnabled=true

# Respaldos: ruta fuera del directorio de la aplicación y retención.
Database__BackupPath=/var/backups/sigm
Database__BackupRetentionCount=30
Database__AutoBackupEnabled=true
Database__AutoBackupIntervalHours=24

# URL pública usada en enlaces de correo (recuperación de contraseña).
App__PublicUrl=https://app.su-dominio.co

# Opcional: rutas explícitas a pg_dump/pg_restore si no están en el PATH.
# PG_DUMP_PATH=/usr/lib/postgresql/18/bin/pg_dump
# PG_RESTORE_PATH=/usr/lib/postgresql/18/bin/pg_restore
