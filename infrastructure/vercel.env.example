# SIGM Cloud — plantilla de variables de entorno para el proyecto de Vercel.
# Copiar a .env.vercel (ignorado por Git) como ayuda para ejecutar migraciones
# con psql/artisan-style, y cargar los mismos valores en Vercel:
#   Project Settings -> Environment Variables (Production y Preview).
# Nunca subir este archivo con valores reales.

# ----------------------------------------------------------------------------
# Neon (Vercel Marketplace). Las inyecta la integración automáticamente.
# DATABASE_URL           -> pooler (transacciones de la API)
# DATABASE_URL_UNPOOLED  -> conexión directa (migraciones/DDL)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://sigm_app:PASSWORD@ep-xxx.region.aws.neon.tech/sigm?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ep-xxx.region.aws.neon.tech/sigm?sslmode=require
PGHOST=ep-xxx.region.aws.neon.tech
PGDATABASE=sigm
PGUSER=sigm_app
PGPASSWORD=PASSWORD

# ----------------------------------------------------------------------------
# API ASP.NET Core (servicio "api")
# Obtener las cadenas desde Neon Console -> Connect -> rol sigm_app / sigm_platform.
# Usar la URL pooling para Default y Platform; Maximum Pool Size bajo porque
# cada instancia de Vercel crea su propio pool.
# ----------------------------------------------------------------------------
ConnectionStrings__Default=Host=ep-xxx.region.aws.neon.tech;Port=5432;Database=sigm;Username=sigm_app;Password=PASSWORD;SSL Mode=Require;Pooling=true;Maximum Pool Size=10;
ConnectionStrings__Platform=Host=ep-xxx.region.aws.neon.tech;Port=5432;Database=sigm;Username=sigm_platform;Password=PASSWORD;SSL Mode=Require;Pooling=true;Maximum Pool Size=10;

Jwt__Issuer=sigm-cloud
Jwt__Audience=sigm-cloud-clients
Jwt__Key=CAMBIAR_POR_CLAVE_ALEATORIA_DE_64_CARACTERES

# Orígenes de los portales (uno por entrada; en JSON: CORS__AllowedOrigins__0, __1, ...)
CORS__AllowedOrigins__0=https://app.TU_DOMINIO.com
CORS__AllowedOrigins__1=https://consultorios.TU_DOMINIO.com
CORS__AllowedOrigins__2=https://pacientes.TU_DOMINIO.com
CORS__AllowedOrigins__3=https://admin.TU_DOMINIO.com
CORS__AllowedOrigins__4=https://www.TU_DOMINIO.com

App__PublicUrl=https://www.TU_DOMINIO.com

# El contenedor de Vercel no tiene disco persistente: desactivar respaldos
# locales y usar PITR/branches de Neon para recuperación.
Database__AutoBackupEnabled=false
Database__BackupPath=/tmp/sigm-backups

# Entrega de recordatorios (SMTP). Dejar en false hasta configurar SMTP.
Reminders__DeliveryEnabled=false
Reminders__Smtp__Host=
Reminders__Smtp__Port=587
Reminders__Smtp__UseStartTls=true
Reminders__Smtp__FromAddress=no-reply@TU_DOMINIO.com
Reminders__Smtp__FromName=SIGM Cloud
Reminders__Smtp__User=
Reminders__Smtp__Password=

# Fijados en el Dockerfile y/o appsettings; se listan para referencia.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
